{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chorust/preludio/schemas/forecast-metadata.schema.json",
  "title": "Preludio forecast metadata (values travel separately as f32 [leads, h, w])",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "encoding",
    "grid",
    "lead_minutes",
    "valid_times",
    "provenance"
  ],
  "properties": {
    "kind": {
      "const": "forecast"
    },
    "encoding": {
      "const": "training-grayscale-normalized",
      "description": "Never dBZ, rain rate, or probability until a verified mapping exists."
    },
    "grid": {
      "$ref": "model-package.schema.json#/$defs/grid"
    },
    "lead_minutes": {
      "type": "array",
      "items": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "description": "For lead index k starting at 1, round(k * (last input time - first input time) / (input frame count - 1)) seconds, then divide by 60. Fractional minutes are allowed; output count follows tensor_output.shape[1]."
    },
    "valid_times": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/utc"
      },
      "description": "last_observation_time + lead; same length as lead_minutes."
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_frames",
        "last_observation_time",
        "model",
        "generated_at",
        "execution",
        "preludio_version"
      ],
      "properties": {
        "input_frames": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "source",
              "valid_time"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "valid_time": {
                "$ref": "#/$defs/utc"
              }
            }
          }
        },
        "last_observation_time": {
          "$ref": "#/$defs/utc"
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "sha256",
            "schema"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "sha256": {
              "$ref": "model-package.schema.json#/$defs/sha256"
            },
            "schema": {
              "const": "preludio.model-package/1"
            }
          }
        },
        "generated_at": {
          "$ref": "#/$defs/utc",
          "description": "When inference finished; never substitutes for valid_times."
        },
        "execution": {
          "$ref": "#/$defs/execution"
        },
        "preludio_version": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "verified",
        "engine",
        "engine_version",
        "provider",
        "threads",
        "platform"
      ],
      "properties": {
        "target_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "verified": {
          "type": "boolean"
        },
        "engine": {
          "enum": [
            "onnxruntime",
            "onnxruntime-web"
          ]
        },
        "engine_version": {
          "type": "string"
        },
        "provider": {
          "enum": [
            "cpu",
            "wasm"
          ]
        },
        "threads": {
          "type": "integer",
          "minimum": 1
        },
        "platform": {
          "type": "string"
        },
        "cross_origin_isolated": {
          "type": "boolean"
        }
      }
    }
  },
  "examples": [
    {
      "kind": "forecast",
      "encoding": "training-grayscale-normalized",
      "grid": {
